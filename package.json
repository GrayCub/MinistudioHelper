{
  "name": "ministudiohelper",
  "displayName": "MinistudioHelper",
  "description": "MiniStudio sync extension, enabling real-time bidirectional synchronization between VS Code and Studio.",
  "icon": "images/logo.png",
  "publisher": "GrayCub",
  "author": "GrayCub",
  "repository": {
    "type": "git",
    "url": "https://github.com/GrayCub/MinistudioHelper"
  },
  "keywords": [
    "Lua",
    "IntelliSense",
    "Ministudio"
  ],
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Snippets"
  ],
  "activationEvents": [
    "workspaceContains:*.project"
  ],
  "extensionDependencies": [
    "sumneko.lua"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "MinistudioHelper",
      "properties": {
        "ministudiohelper.runtime.plugin": {
          "type": "string",
          "default": "${extensionPath}/luals-addon/plugin.lua",
          "description": "插件路径"
        },
        "ministudiohelper.workspace.library": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "${extensionPath}/luals-addon/adk_types"
          ],
          "description": "MiniStudio类型声明文件路径列表"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "miniStudioContainer",
          "title": "MiniStudio 节点树",
          "icon": "images/logo.svg"
        }
      ]
    },
    "views": {
      "miniStudioContainer": [
        {
          "icon": "images/logo.svg",
          "id": "ministudiohelper.ministudionodetree",
          "name": "游戏节点树"
        }
      ]
    },
    "commands": [
      {
        "command": "ministudiohelper.copyNodeName",
        "title": "复制节点名称"
      },
      {
        "command": "ministudiohelper.copyTypeName",
        "title": "复制节点类型"
      },
      {
        "command": "ministudiohelper.openScript",
        "title": "打开对应脚本"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "ministudiohelper.copyNodeName",
          "when": "view == ministudiohelper.ministudionodetree && viewItem == ministudioNode",
          "group": "1_copy"
        },
        {
          "command": "ministudiohelper.copyTypeName",
          "when": "view == ministudiohelper.ministudionodetree && viewItem == ministudioNode",
          "group": "1_copy"
        },
        {
          "command": "ministudiohelper.openScript",
          "when": "view == ministudiohelper.ministudionodetree && viewItem == ministudioNode",
          "group": "2_open"
        }
      ]
    }
  },
  "scripts": {
    "package:win64": "vsce package --target win32-x64 --no-dependencies",
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@types/winreg": "^1.2.36",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "winreg": "^1.2.5"
  }
}
